# Copia este archivo a .env y rellénalo SOLO en tu equipo.
NODE_ENV=development
PORT=8888
BIND_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=echohead
DB_USER=echohead_app
DB_PASSWORD=
# Activa TLS para una BD remota. Nunca usar rejectUnauthorized:false.
DB_SSL=false
# DB_SSL_CA_FILE=/ruta/ca-del-proveedor.pem
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe ser la dirección REAL del frontend, sin ruta ni diagonal final.
FRONTEND_ORIGIN=https://tu-frontend.example
# Registrar exactamente esta URL en el Dashboard de Spotify.
REDIRECT_URI=https://tu-frontend.example/callback
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Dejar vacío si no has definido un proxy confiable y aislado del acceso directo.
TRUST_PROXY=

# Contacto público real del responsable (correo o URL HTTPS con contacto).
# Solo se envía a MusicBrainz en User-Agent. No es una contraseña.
MUSICBRAINZ_CONTACT=
