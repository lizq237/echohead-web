# EJEMPLO: adaptar dominio, rutas y certificados antes de usar.
# Servir frontend y backend bajo el MISMO origen evita cookies de terceros.
server {
    listen 443 ssl;
    server_name echohead.example;
    ssl_certificate /ruta/fullchain.pem;
    ssl_certificate_key /ruta/privkey.pem;
    root /ruta/echohead/frontend/dist;
    client_max_body_size 32k;

    # No registrar parámetros de callback, cabeceras Authorization o cookies.
    # En producción configurar un log_format con $uri (NO $request_uri/$request).
    location = /callback { access_log off; try_files $uri /index.html; }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self' https://api.spotify.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location /backend/ {
        proxy_pass http://127.0.0.1:8888/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Sobrescribir, no concatenar un valor aportado por el visitante.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
